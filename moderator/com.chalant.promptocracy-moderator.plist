<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.chalant.promptocracy-moderator</string>
    <!-- Disabled until Chalant's first-night trial (busterbenson/promptocracy, step 1 PR 5 runbook).
         Remove this key, then run scripts/install-launchd.sh, to go live. -->
    <key>Disabled</key>
    <true/>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/chalantbenson/chalantbot/repos/promptocracy/moderator/run.sh</string>
    </array>
    <!-- schedule:begin (generated by moderator/schedule.mjs from register.json; do not edit by hand, run it again).
         Two runs a night per game, in this machine's time zone (America/Los_Angeles): the main run just after the
         day's end and the backstop an hour before the deadline.
         Games (game time zone, main and backstop in that zone): rickshaw-1 America/Los_Angeles 00:02 and 01:00. 2 entries.
         A run missed while the Mac is asleep still happens: launchd starts the job once on wake.
         AbandonProcessGroup lets the detached reload helper outlive the run that started it. -->
    <key>AbandonProcessGroup</key>
    <true/>
    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Hour</key><integer>0</integer><key>Minute</key><integer>2</integer></dict>
        <dict><key>Hour</key><integer>1</integer><key>Minute</key><integer>0</integer></dict>
    </array>
    <!-- schedule:end -->
    <key>StandardOutPath</key>
    <string>/Users/chalantbenson/chalantbot/logs/promptocracy-moderator/launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/chalantbenson/chalantbot/logs/promptocracy-moderator/launchd.err.log</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/Users/chalantbenson/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>HOME</key>
        <string>/Users/chalantbenson</string>
    </dict>
</dict>
</plist>
